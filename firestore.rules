rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isClassMember(classId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/classes/$(classId));
    }

    function areBothClassMembers(userId, classId) {
      return request.auth != null
        && classId is string
        && exists(/databases/$(database)/documents/users/$(userId)/classes/$(classId))
        && isClassMember(classId);
    }

    function hasPersonalClass(userId, data) {
      return !data.keys().hasAny(['schedule_id'])
        || (data.schedule_id is string
          && exists(/databases/$(database)/documents/users/$(userId)/classes/$(data.schedule_id)));
    }

    function writesToJoinedClass(data) {
      return !data.keys().hasAny(['schedule_id'])
        || (data.schedule_id is string && isClassMember(data.schedule_id));
    }

    function validTask() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'day', 'subject', 'message', 'color', 'week_start',
          'is_exam', 'completed', 'created_at'
        ])
        && data.keys().hasOnly([
          'day', 'subject', 'message', 'color', 'week_start',
          'is_exam', 'completed', 'created_at', 'schedule_id'
        ])
        && data.day in ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes']
        && data.subject is string
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 500
        && data.color is string
        && data.week_start is string
        && data.week_start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.is_exam is bool
        && data.completed is bool
        && (!data.keys().hasAny(['schedule_id']) || data.schedule_id is string)
        && data.created_at is timestamp;
    }

    function validClass(classId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'name', 'access_code', 'owner_id', 'has_schedule', 'subjects', 'cells', 'created_at'
        ])
        && data.keys().hasOnly([
          'name', 'access_code', 'owner_id', 'has_schedule', 'subjects',
          'cells', 'times', 'created_at'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.access_code is string
        && data.access_code.matches('^[A-Z0-9]{6,12}$')
        && data.owner_id == request.auth.uid
        && data.has_schedule is bool
        && data.subjects is list
        && data.cells is map
        && (!data.keys().hasAny(['times']) || data.times is list)
        && data.created_at is timestamp
        && getAfter(/databases/$(database)/documents/class_codes/$(data.access_code)).data.class_id == classId;
    }

    function validLegacyClass() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'name', 'has_schedule', 'subjects', 'cells', 'created_at'
        ])
        && data.keys().hasOnly([
          'name', 'has_schedule', 'subjects', 'cells', 'times', 'created_at'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.has_schedule is bool
        && data.subjects is list
        && data.cells is map
        && (!data.keys().hasAny(['times']) || data.times is list)
        && data.created_at is timestamp;
    }

    function validMemberSchedule() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'access_code', 'created_at', 'has_schedule', 'subjects', 'cells'
        ])
        && data.keys().hasOnly([
          'access_code', 'created_at', 'has_schedule', 'subjects', 'cells',
          'times'
        ])
        && data.access_code is string
        && data.access_code.matches('^[A-Z0-9]{6,12}$')
        && data.created_at is timestamp
        && data.has_schedule is bool
        && data.subjects is list
        && data.cells is map
        && (!data.keys().hasAny(['times']) || data.times is list);
    }

    function validReminder() {
      let data = request.resource.data;
      return data.keys().hasAll(['subject', 'message', 'completed', 'created_at'])
        && data.keys().hasOnly(['subject', 'message', 'completed', 'created_at', 'schedule_id'])
        && data.subject is string
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 500
        && data.completed is bool
        && data.created_at is timestamp
        && (!data.keys().hasAny(['schedule_id']) || data.schedule_id is string);
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if owns(userId)
        || areBothClassMembers(userId, resource.data.schedule_id);
      allow delete: if owns(userId);
      allow create, update: if owns(userId)
        && validTask()
        && hasPersonalClass(userId, request.resource.data)
        && writesToJoinedClass(request.resource.data);
    }

    match /users/{userId}/classes/{classId} {
      allow read, delete: if owns(userId);
      allow update: if owns(userId)
        && (validLegacyClass()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'has_schedule', 'subjects', 'cells', 'times'
          ]) && validMemberSchedule()));
      allow create: if owns(userId)
        && request.resource.data.keys().hasAll(['access_code', 'created_at'])
        && request.resource.data.keys().hasOnly(['access_code', 'created_at'])
        && request.resource.data.access_code is string
        && request.resource.data.access_code.matches('^[A-Z0-9]{6,12}$')
        && request.resource.data.created_at is timestamp
        && getAfter(/databases/$(database)/documents/class_codes/$(request.resource.data.access_code)).data.class_id == classId
        && getAfter(/databases/$(database)/documents/classes/$(classId)).data.access_code == request.resource.data.access_code;
    }

    match /class_codes/{accessCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['class_id', 'created_by', 'created_at'])
        && request.resource.data.keys().hasOnly(['class_id', 'created_by', 'created_at'])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.created_at is timestamp
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.class_id)).data.owner_id == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.class_id)).data.access_code == accessCode;
      allow update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if isClassMember(classId);
      allow create: if request.auth != null && validClass(classId);
      allow update: if isClassMember(classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'has_schedule', 'subjects', 'cells', 'times'
        ]);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isClassMember(classId);
        allow create: if request.auth != null
          && request.auth.uid == memberId
          && getAfter(/databases/$(database)/documents/users/$(memberId)/classes/$(classId)).data.access_code is string
          && request.resource.data.keys().hasAll(['display_name', 'created_at'])
          && request.resource.data.keys().hasOnly(['display_name', 'created_at'])
          && request.resource.data.display_name is string
          && request.resource.data.created_at is timestamp;
        allow delete: if request.auth != null
          && request.auth.uid == memberId
          && exists(/databases/$(database)/documents/users/$(memberId)/classes/$(classId));
        allow update: if false;
      }
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read: if owns(userId)
        || areBothClassMembers(userId, resource.data.schedule_id);
      allow delete: if owns(userId);
      allow create, update: if owns(userId)
        && validReminder()
        && hasPersonalClass(userId, request.resource.data)
        && writesToJoinedClass(request.resource.data);
    }
  }
}